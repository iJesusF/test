# Local developer environment for Vortech 360
# Copy to .env.local and replace placeholder values when you want Supabase-backed persistence.
# The app can still run local-first without real Supabase values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FLOORPLANS_BUCKET=floorplans
SUPABASE_ATTACHMENTS_BUCKET=attachments
NEXT_PUBLIC_APP_URL=http://localhost:3000
